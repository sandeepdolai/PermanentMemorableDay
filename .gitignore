# See https://help.github.com/articles/ignoring-files/ for more information about ignoring files.

# NOTE (Task 28-b, 2026-09-20): user directed that ALL files be pushed to the
# PRIVATE repo PermanentMemorableDay. The database (db/), .env, storage/ +
# upload/ media, dev logs, skills/, .zscripts/ and next-env.d.ts are TRACKED.
# Only regenerable machinery and agent session state remain ignored.

# dependencies (regenerable via `bun install` from package.json + bun.lock)
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js build output (regenerable via next dev / next build)
/.next/
/out/

# production build output (regenerable)
/build

# misc
.DS_Store
*.pem

# package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript incremental cache (regenerable)
*.tsbuildinfo

# agent session state (not project files)
.claude
.z-ai-config

# agent QA screenshot artifacts
/tool-results/
--full-page
qa/
storage/
