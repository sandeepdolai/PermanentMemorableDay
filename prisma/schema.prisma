// MemorableDay — Prisma schema (SQLite)
// Real persistence for moments, drafts, notifications and saved templates.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  plan        String    @default("Free")
  credits     Int       @default(240)
  onboarded   Boolean   @default(false)
  /// One-time localStorage → server migration marker
  migratedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  moments        Moment[]
  notifications  Notification[]
  savedTemplates SavedTemplate[]
}

/// A moment experience — seeded previews, user drafts, scheduled & sent moments.
model Moment {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  recipient   String    @default("")
  /// draft | scheduled | sent | viewed | archived
  status      String    @default("draft")
  /// Status to restore when unarchived (archive keeps a memory of the real status)
  prevStatus  String?
  /// seed (shipped preview content) | user (created in the builder)
  source      String    @default("user")

  cover       Int       @default(0)
  scenes      Int       @default(3)
  blocks      Int       @default(0)
  /// Authored experience document — JSON SceneDoc[] built in the builder
  sceneData   String?
  /// Experience soundtrack pick — JSON SongPick (searched catalog song + snippet)
  trackData   String?
  views       Int       @default(0)
  loves       Int       @default(0)
  /// 0–100 (nullable until a moment has analytics)
  completion  Int?
  /// Builder progress 0–100 for drafts
  progress    Int?
  /// JSON string array of tags
  tags        String    @default("[]")
  /// Human display date ("Sent Oct 12", "Edited 2h ago", …)
  dateLabel   String    @default("Just now")

  /// Deterministic share slug for the recipient link (assigned on send/schedule)
  shareSlug   String?   @unique
  scheduledFor DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  notifications Notification[]
}

/// Activity feed notification (opened / loved / milestone / reminder / credits / sent).
model Notification {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      String
  title     String
  body      String
  timeLabel String   @default("now")
  /// today | earlier
  group     String   @default("today")
  unread    Boolean  @default(true)
  /// Coalescing counter — how many raw events this row summarizes (opened ×N, loved ×N)
  count     Int      @default(1)

  momentId  String?
  moment    Moment?  @relation(fields: [momentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

/// Explore template saved to the user's collection.
model SavedTemplate {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String
  createdAt  DateTime @default(now())

  @@unique([userId, templateId])
}

/// Claw-machine coupon assignment — ONE coupon per player per machine
/// (machine = moment + block). Created once on the player's first PLAY by
/// the server (random pick from the creator's eligible pool, stock-aware);
/// every later play reads the same row back. The random selection happens
/// exactly once per player — enforced here, in the database, not in the
/// browser. `playerId` is the anonymous recipient identity (md_player cookie
/// — recipients don't log in); swap for the auth user id when auth lands.
model CouponAssignment {
  id        String   @id @default(cuid())
  momentId  String
  blockId   String
  playerId  String

  /// Pool-item id at claim time (matches CouponDef.id in the authored block)
  couponId  String
  /// Code snapshot — the prize stays valid even if the creator edits the pool
  code      String
  /// Title snapshot ("" when the coupon had no title)
  title     String   @default("")
  /// Card color snapshot (pile-card visual fallback)
  color     String   @default("#9B59B6")
  /// When the player first won the coupon
  claimedAt DateTime @default(now())

  @@unique([momentId, blockId, playerId])
  @@index([momentId, blockId])
}
